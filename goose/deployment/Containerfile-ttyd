# ─────────────────────────────────────────────────────────────────────────────
# Goose CLI + ttyd web terminal container image (OpenShift-compatible)
#
# Installs community Goose via the official download script (see ../README.md).
# Optional Red Hat / EPEL install notes are in README-ttyd.md.
#
# Build (from goose/):
#   podman build -t quay.io/kenghua_yeo/goose-ttyd:v1 \
#     -f deployment/Containerfile-ttyd deployment/
#
# Run:    podman run --rm -p 7681:7681 \
#           -e OPENAI_API_KEY=mykey \
#           -e GOOSE_PROVIDER=openai \
#           -e GOOSE_MODEL=gpt-4o \
#           -v goose-config:/home/goose/.config/goose \
#           -v goose-workspace:/home/goose/workspace \
#           quay.io/kenghua_yeo/goose-ttyd:v1
#
# Access: http://localhost:7681  (starts in bash — run `goose configure` / `goose session`)
#
# OpenShift deployment notes:
#   - Runs as uid 1001 (no root, no privileged SCC required)
#   - Exposes port 7681 (unprivileged)
#   - Set API keys via Secret → env vars in your Deployment spec
#   - Add --credential user:pass to CMD for basic auth, or front with an
#     OpenShift Route + OAuth proxy for proper authN/Z
# ─────────────────────────────────────────────────────────────────────────────

ARG RHEL_VERSION=9

FROM registry.access.redhat.com/ubi${RHEL_VERSION}:latest

ARG RHEL_VERSION

# ── 1. System dependencies + community goose (as root) ───────────────────────
# Pre-req: bzip2 (used by the Goose download script archive).
# Install location: /usr/local/bin so the binary is on PATH for any UID.
RUN dnf install -y \
    ca-certificates \
    curl \
    git \
    bzip2 \
    tar \
    python3 \
    sudo \
    && curl -fsSL https://github.com/aaif-goose/goose/releases/download/stable/download_cli.sh \
         | CONFIGURE=false GOOSE_BIN_DIR=/usr/local/bin bash \
    && command -v goose \
    && goose --version \
    && dnf clean all

# Alternative (Red Hat / EPEL packaged goose) — replace the curl install block above with:
#   dnf install -y https://dl.fedoraproject.org/pub/epel/epel-release-latest-${RHEL_VERSION}.noarch.rpm \
#     && dnf install -y goose \
#   Ensure goose-redhat is NOT present if you want generic provider setup:
#     rpm -q goose-redhat >/dev/null 2>&1 && exit 1 || true

# ttyd – static self-contained binary, no extra libs required
RUN curl -L -o /usr/local/bin/ttyd \
    https://github.com/tsl0922/ttyd/releases/download/1.7.7/ttyd.x86_64 \
 && chmod +x /usr/local/bin/ttyd

# ── 2. Non-root user + directory setup ───────────────────────────────────────
RUN useradd -m -u 1001 -G wheel goose \
    && echo '%wheel ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/wheel-nopasswd

RUN mkdir -p \
    /home/goose/.config/goose/custom_providers \
    /home/goose/workspace

COPY config.yaml /home/goose/.config/goose/config.yaml
COPY entrypoint.sh /usr/local/bin/entrypoint.sh

RUN chmod +x /usr/local/bin/entrypoint.sh \
    && chown -R 1001:0 /home/goose \
    && chmod -R g+rwX /home/goose

# ── 3. Environment ────────────────────────────────────────────────────────────
ENV GOOSE_DISABLE_KEYRING=1 \
    GOOSE_MODE=smart_approve \
    GOOSE_TELEMETRY_OFF=1 \
    TERM=xterm-256color \
    HOME=/home/goose \
    PATH="/usr/local/bin:${PATH}"

# ── 4. Persist goose state via named volumes ──────────────────────────────────
#   -v goose-config:/home/goose/.config/goose
#   -v goose-workspace:/home/goose/workspace
VOLUME ["/home/goose/.config/goose", "/home/goose/workspace"]

USER 1001
WORKDIR /home/goose/workspace

EXPOSE 7681

# Start in bash so the user can run `goose configure` then `goose session`.
# To auto-start a session instead:
#   ["ttyd", "--port", "7681", "--writable", "goose", "session"]
CMD ["ttyd", "--port", "7681", "--writable", "bash"]
