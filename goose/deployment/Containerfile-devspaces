# Goose AI Agent — OpenShift Dev Spaces image
#
# Layers community Goose onto redhat-cop/devspaces-base so workspaces start
# with goose on PATH. Uses the official download script (see ../README.md).
#
# Base: quay.io/redhat-cop/devspaces-base already includes:
#   git, curl, jq, vim, bash, zsh, ripgrep, fd, bat, gh-cli, buildah, podman
#   Arbitrary-UID entrypoint, HOME=/home/user, WORKDIR=/projects
#
# Build (from goose/):
#   podman build \
#     -t quay.io/kenghua_yeo/goose-devspaces:v2 \
#     -f deployment/Containerfile-devspaces \
#     deployment/
#
# Push:
#   podman push quay.io/kenghua_yeo/goose-devspaces:v2
#
# Update goose:
#   Rebuild with --no-cache and repush; the devfile image ref picks it up on
#   the next workspace restart (Dev Spaces pulls Always by default).
#
# Alternative (Red Hat / EPEL):
#   Replace the curl install with:
#     dnf install -y https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm \
#       && dnf install -y goose
#   See README-devspaces.md for details.

FROM quay.io/redhat-cop/devspaces-base:latest

LABEL name="goose-devspaces" \
      summary="Goose AI agent CLI developer container for OpenShift Dev Spaces" \
      description="Dev Spaces workspace image with Goose pre-installed. Run 'goose' from the Web Terminal." \
      io.k8s.description="Goose AI agent developer container for OpenShift Dev Spaces" \
      io.k8s.display-name="Goose AI Agent Dev Spaces"

USER root

# bzip2 is required by the Goose download script.
# UBI9 ships curl-minimal; do not install curl (conflicts).
RUN dnf install -y bzip2 tar \
    && curl -fsSL https://github.com/aaif-goose/goose/releases/download/stable/download_cli.sh \
         | CONFIGURE=false GOOSE_BIN_DIR=/usr/local/bin bash \
    && command -v goose \
    && goose --version \
    && dnf clean all

# Pre-create config dirs; group-0 + g+rwX lets OpenShift's arbitrary UID write here
RUN mkdir -p /home/user/.config/goose/custom_providers \
    && chown -R 10001:0 /home/user/.config/goose \
    && chmod -R g+rwX /home/user/.config/goose

# First-run helper: prompts for provider/model/key, writes goose config, starts goose
COPY --chmod=755 goose-first-start.sh /usr/local/bin/goose-first-start.sh

# Bake in the default extensions config (provider/model are injected at runtime)
COPY --chown=10001:0 config.yaml /home/user/.config/goose/config.yaml

ENV GOOSE_DISABLE_KEYRING=1 \
    GOOSE_MODE=smart_approve \
    GOOSE_TELEMETRY_OFF=1 \
    HOME=/home/user \
    TERM=xterm-256color \
    PATH="/usr/local/bin:${PATH}"

USER 10001
WORKDIR /projects
CMD ["tail", "-f", "/dev/null"]
